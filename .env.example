# Anthropic API key, used to parse bet messages into structured data
ANTHROPIC_API_KEY=

# The Google Sheet you're using as the bet ledger (the long ID in its URL)
GOOGLE_SHEET_ID=

# Path to the service account JSON key you downloaded from Google Cloud
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account.json

# Your golf group's WhatsApp JID, e.g. 123456789012345678@g.us
# Leave blank on first run - the bot will log every group JID it sees to the
# console so you can find and copy the right one in, then restart.
GOLF_GROUP_JID=

# Port for the local dashboard (http://localhost:PORT) - defaults to 3000
DASHBOARD_PORT=

# Destination for "@BeerBot get me home" - a Google Maps directions link is sent from
# the sender's current location to this address (leave blank to disable)
HOME_DESTINATION=

# Lat/lng for HOME_DESTINATION - required for the Uber link to auto-fill the dropoff
# (Uber needs coordinates, not just an address string). Leave blank to omit the Uber link.
HOME_LAT=
HOME_LNG=

# Path to a freeform text file describing this trip (dates, courses, who's on it, schedule) -
# given to the bot as background context when parsing/resolving bets and answering questions.
# See trip-context.example.md for the expected shape. Leave blank to omit.
TRIP_CONTEXT_PATH=
