# Anthropic API key, used to parse bet messages into structured data
ANTHROPIC_API_KEY=

# The Google Sheet you're using as the bet ledger (the long ID in its URL)
GOOGLE_SHEET_ID=

# Path to the service account JSON key you downloaded from Google Cloud
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account.json

# Your golf group's WhatsApp JID, e.g. 123456789012345678@g.us
# Leave blank on first run - the bot will log every group JID it sees to the
# console so you can find and copy the right one in, then restart.
GOLF_GROUP_JID=

# Port for the local dashboard (http://localhost:PORT) - defaults to 3000
DASHBOARD_PORT=
